# نسخة وهمية للتطوير المحلي فقط. انسخها إلى .env ولا ترفع .env أبدًا.
# بيانات اصطناعية فقط: لا بيانات مرضى حقيقية في أي بيئة.

# --- قاعدة البيانات ---
# المالك (للـ migrations فقط)
DB_MIGRATOR_PASSWORD=change_me_migrator
DB_APP_PASSWORD=change_me_app
DATABASE_URL=postgresql://cliniccare_app:change_me_app@localhost:5432/cliniccare
MIGRATE_DATABASE_URL=postgresql://cliniccare_migrator:change_me_migrator@localhost:5432/cliniccare

# --- الجلسات والأمان ---
SESSION_SECRET=replace_with_32_random_bytes_hex
SESSION_TTL_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
WEB_ORIGIN=http://localhost:3000

# --- التخزين (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=cliniccare-docs
S3_ACCESS_KEY=minio_dev_access
S3_SECRET_KEY=minio_dev_secret_change_me
SIGNED_URL_TTL_SECONDS=60

# --- البريد التجريبي (MailHog) ---
SMTP_URL=smtp://localhost:1025

# --- التطبيق ---
API_PORT=4000
DEFAULT_CLINIC_ID=00000000-0000-4000-8000-000000000001
