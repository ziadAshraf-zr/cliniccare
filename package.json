{
  "name": "cliniccare",
  "private": true,
  "version": "0.1.0",
  "description": "ClinicCare — academic EHR/clinic management project (synthetic data only)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @cliniccare/api --filter @cliniccare/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && pnpm db:seed",
    "gen:prisma": "prisma generate"
  },
  "prisma": { "schema": "prisma/schema.prisma" },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "argon2": "^0.41.1"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["argon2", "@prisma/client", "@prisma/engines", "prisma", "esbuild", "@nestjs/core", "sharp"] }
}
